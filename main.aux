\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Scaling Analysis Across Orders}{19}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Scaling analysis across orders $n = 3, 4, 5$. (a) Convex hull volume increases with order, reflecting the larger range of $z$-values. (b) The fraction of points on the hull boundary decreases as interior points proliferate. (c) The minimum perturbation gap decreases with order, suggesting larger magic squares are ``less isolated'' in the energy landscape. (d) The magic constant $M(n) = n(n^2+1)/2$ grows quadratically.}}{20}{figure.22}\protected@file@percent }
\newlabel{fig:scaling_analysis}{{22}{20}{Scaling analysis across orders $n = 3, 4, 5$. (a) Convex hull volume increases with order, reflecting the larger range of $z$-values. (b) The fraction of points on the hull boundary decreases as interior points proliferate. (c) The minimum perturbation gap decreases with order, suggesting larger magic squares are ``less isolated'' in the energy landscape. (d) The magic constant $M(n) = n(n^2+1)/2$ grows quadratically}{figure.22}{}}
