\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Exact moments of Proposition~\ref {prop:random_energy_moments} against Monte Carlo ($10^8$ uniformly random arrangements per order; for $n=3$ the exact values were also confirmed by enumerating all $9!$ arrangements). $|\delta _{\mathrm  {mean}}|$ is the relative error of the MC mean; all MC means and variances agree with the exact values to within $5\times 10^{-4}$ relative error, consistent with the sampling standard errors. ``Gauss.\ std'' is the standard deviation of the Gaussian-limit mixture $\DOTSB \sum@ \slimits@ _j w_j\chi ^2_1$ of Corollary~\ref {cor:random_energy_clt}, and KS is the Kolmogorov distance between the MC sample and that mixture (not the Exp(1) limit).}}{16}{table.92}\protected@file@percent }
\newlabel{tab:random_energy}{{1}{16}{Exact moments of Proposition~\ref {prop:random_energy_moments} against Monte Carlo ($10^8$ uniformly random arrangements per order; for $n=3$ the exact values were also confirmed by enumerating all $9!$ arrangements). $|\delta _{\mathrm {mean}}|$ is the relative error of the MC mean; all MC means and variances agree with the exact values to within $5\times 10^{-4}$ relative error, consistent with the sampling standard errors. ``Gauss.\ std'' is the standard deviation of the Gaussian-limit mixture $\sum _j w_j\chi ^2_1$ of Corollary~\ref {cor:random_energy_clt}, and KS is the Kolmogorov distance between the MC sample and that mixture (not the Exp(1) limit)}{table.92}{}}
