\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Energy of a uniformly random arrangement. (a) Distribution of $E_{\mathrm  {low}}/\mathbb  {E}[E_{\mathrm  {low}}]$ for $n=3$ (exact, all $9!$ arrangements) and $n=5,8$ ($10^8$ Monte Carlo samples each), with the Gaussian-limit mixture densities (dashed, Imhof inversion with the weights \eqref  {eq:weights}) and the $n\to \infty $ limit $\mathrm  {Exp}(1)$ of Corollary~\ref {cor:random_energy_clt} (dotted). (b) The same for the symmetric $E_{\mathrm  {full}}$; here the Gaussian mixture is only a slowly improving approximation (see the remark after Corollary~\ref {cor:random_energy_clt}). (c) Exact mean (solid) and standard deviation (dashed) of both energies from Proposition~\ref {prop:random_energy_moments}, $3\le n\le 40$, with the Monte Carlo values for $n=3,\dots  ,8$ (open markers). The mean of $E_{\mathrm  {low}}$ grows like $n^4/72$ and its standard deviation like $n^4/72$ as well (an exponential limit has unit coefficient of variation); $E_{\mathrm  {full}}$ has mean $\sim n^2/6$ and standard deviation $\sim n^{3/2}/6$.}}{17}{figure.94}\protected@file@percent }
\newlabel{fig:random_energy}{{2}{17}{Energy of a uniformly random arrangement. (a) Distribution of $\Elow /\E [\Elow ]$ for $n=3$ (exact, all $9!$ arrangements) and $n=5,8$ ($10^8$ Monte Carlo samples each), with the Gaussian-limit mixture densities (dashed, Imhof inversion with the weights \eqref {eq:weights}) and the $n\to \infty $ limit $\mathrm {Exp}(1)$ of Corollary~\ref {cor:random_energy_clt} (dotted). (b) The same for the symmetric $\Efull $; here the Gaussian mixture is only a slowly improving approximation (see the remark after Corollary~\ref {cor:random_energy_clt}). (c) Exact mean (solid) and standard deviation (dashed) of both energies from Proposition~\ref {prop:random_energy_moments}, $3\le n\le 40$, with the Monte Carlo values for $n=3,\dots ,8$ (open markers). The mean of $\Elow $ grows like $n^4/72$ and its standard deviation like $n^4/72$ as well (an exponential limit has unit coefficient of variation); $\Efull $ has mean $\sim n^2/6$ and standard deviation $\sim n^{3/2}/6$}{figure.94}{}}
