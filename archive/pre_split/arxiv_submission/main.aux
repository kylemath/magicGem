\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Breakdown of $L_4$ by the number of row sums and column sums equal to $M(4)=34$. Exactly two or three equal row sums are impossible: if $R_i=34+e_i$ then $\DOTSB \sum@ \slimits@ _i e_i=0$ and $\DOTSB \sum@ \slimits@ _i i\,e_i=0$ (this is $T_2$), which cannot hold with exactly one or two nonzero $e_i$; the same holds for columns. The table is symmetric under transposition.}}{18}{table.99}\protected@file@percent }
\newlabel{tab:L4}{{2}{18}{Breakdown of $L_4$ by the number of row sums and column sums equal to $M(4)=34$. Exactly two or three equal row sums are impossible: if $R_i=34+e_i$ then $\sum _i e_i=0$ and $\sum _i i\,e_i=0$ (this is $T_2$), which cannot hold with exactly one or two nonzero $e_i$; the same holds for columns. The table is symmetric under transposition}{table.99}{}}
