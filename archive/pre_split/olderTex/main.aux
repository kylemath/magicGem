\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Scaling Properties Across Orders.} (A) Peak energy follows quadratic scaling with $R^2 > 0.99$. (B) Mean energy with standard deviation error bars, showing increasing variance. (C) Landscape entropy remains near-constant at $H \approx 4.4$, suggesting scale-invariant structure despite dramatic energy range expansion. (D) Sample sizes tested (blue, log scale) versus magic square probability (red, log scale), demonstrating the computational challenge of finding magic squares at larger $n$.}}{21}{figure.8}\protected@file@percent }
\newlabel{fig:scaling_summary}{{8}{21}{\textbf {Scaling Properties Across Orders.} (A) Peak energy follows quadratic scaling with $R^2 > 0.99$. (B) Mean energy with standard deviation error bars, showing increasing variance. (C) Landscape entropy remains near-constant at $H \approx 4.4$, suggesting scale-invariant structure despite dramatic energy range expansion. (D) Sample sizes tested (blue, log scale) versus magic square probability (red, log scale), demonstrating the computational challenge of finding magic squares at larger $n$}{figure.8}{}}
