\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Nested ``diamond-in-a-diamond'' convex layers $\mathcal  G_0(S)\supset \mathcal  G_1(S)$ and centre-of-mass restoration. (a)~Denser-core Gem \#673 ($(V_0,V_1)=(8,8)$, \Cref  {fig:hero-squares}(e)) and (b)~hollow-cavity Gem \#54 ($(V_0,V_1)=(10,6)$, $1$-swap sibling of \#45 in \Cref  {fig:hero-squares}(c)), showing the translucent outer hull $\mathcal  G_0(S)$ enclosing the inner core gem $\mathcal  G_1(S)$ alongside 2D fulcrum lever diagrams at bottom. On \#673, $\mathbf  c_0=(0,0,-20/257)$ (green circle) and $\mathbf  c_1=(0,0,+2/7)$ (gold diamond) lie on opposite sides of $O$, balancing via a heavier inner core ($\Delta \rho _1/\rho _0=+5/4$, $\rho _1/\rho _0=2.25$). On \#54, although the discrete outer vertices still pull to $-y$ ($\overline  {\mathbf  p}_{\mathrm  {outer}}=(0,-3/10,0)$), volumetric simplex weighting pulls $\mathbf  c_0=(0,+19/324,0)$ onto the $+y$ side alongside $\mathbf  c_1=(0,+29/68,0)$, so subtracting a $98.3\%$ hollow core cavity ($\Delta \rho _1/\rho _0=-57/58$, $\rho _1/\rho _0=1/58$) restores balance at $O$. (c)~Breakdown of nested layer properties and balance mechanisms across all $880$ order-four magic squares.}}{16}{figure.92}\protected@file@percent }
\newlabel{fig:nested-diamonds}{{5}{16}{Nested ``diamond-in-a-diamond'' convex layers $\mathcal G_0(S)\supset \mathcal G_1(S)$ and centre-of-mass restoration. (a)~Denser-core Gem \#673 ($(V_0,V_1)=(8,8)$, \Cref {fig:hero-squares}(e)) and (b)~hollow-cavity Gem \#54 ($(V_0,V_1)=(10,6)$, $1$-swap sibling of \#45 in \Cref {fig:hero-squares}(c)), showing the translucent outer hull $\mathcal G_0(S)$ enclosing the inner core gem $\mathcal G_1(S)$ alongside 2D fulcrum lever diagrams at bottom. On \#673, $\mathbf c_0=(0,0,-20/257)$ (green circle) and $\mathbf c_1=(0,0,+2/7)$ (gold diamond) lie on opposite sides of $O$, balancing via a heavier inner core ($\Delta \rho _1/\rho _0=+5/4$, $\rho _1/\rho _0=2.25$). On \#54, although the discrete outer vertices still pull to $-y$ ($\overline {\mathbf p}_{\mathrm {outer}}=(0,-3/10,0)$), volumetric simplex weighting pulls $\mathbf c_0=(0,+19/324,0)$ onto the $+y$ side alongside $\mathbf c_1=(0,+29/68,0)$, so subtracting a $98.3\%$ hollow core cavity ($\Delta \rho _1/\rho _0=-57/58$, $\rho _1/\rho _0=1/58$) restores balance at $O$. (c)~Breakdown of nested layer properties and balance mechanisms across all $880$ order-four magic squares}{figure.92}{}}
\newlabel{eq:density-ratio}{{25}{16}{Composite ``diamond-in-a-diamond'' solid balancing}{equation.96}{}}
