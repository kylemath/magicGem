\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Low-Mode Energy Scaling Properties.} (A) Peak low-mode energy follows quadratic scaling with $R^2 > 0.99$. (B) Mean energy with standard deviation error bars, showing increasing variance. (C) Landscape entropy varies modestly across orders ($H \approx 4.3$--$5.0$), suggesting scale-invariant structure despite dramatic energy range expansion. (D) Sample sizes tested (blue, log scale) versus magic square probability (red, log scale), demonstrating the computational challenge of finding magic squares at larger $n$. Note: These statistics characterize the low-mode energy $E_{\mathrm  {low}}$ landscape; the complete energy $E_{\mathrm  {full}}$ has qualitatively similar scaling behavior.}}{23}{figure.104}\protected@file@percent }
\newlabel{fig:scaling_summary}{{7}{23}{\textbf {Low-Mode Energy Scaling Properties.} (A) Peak low-mode energy follows quadratic scaling with $R^2 > 0.99$. (B) Mean energy with standard deviation error bars, showing increasing variance. (C) Landscape entropy varies modestly across orders ($H \approx 4.3$--$5.0$), suggesting scale-invariant structure despite dramatic energy range expansion. (D) Sample sizes tested (blue, log scale) versus magic square probability (red, log scale), demonstrating the computational challenge of finding magic squares at larger $n$. Note: These statistics characterize the low-mode energy $E_{\mathrm {low}}$ landscape; the complete energy $E_{\mathrm {full}}$ has qualitatively similar scaling behavior}{figure.104}{}}
