\newlabel{tab:multi_order_settler}{{7}{16}{Multi-order synthesis benchmark of the Re-Anchored Hierarchical Multi-Cycle Settler across orders $n = 3, 4, 5, 6, 7, 8$, certified by \texttt {verify\_paper\_d.py}. Note the \emph {Dimensional Relief Phenomenon} at $n \ge 6$: as the nullspace dimension $\dim \ker (\Ltilde _n) = n^2-2n-1$ grows quadratically (\Cref {thm:spectral_rationalization}), the number of restarts required to hit $\Hline =0$ peaks at $n=5$ ($8.03$) and decreases for $n=6,7,8$}{table.93}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Multi-order $100\%$ ground-state synthesis ($n=3\dots  8$) and the Dimensional Relief Phenomenon.} \textbf  {(a)} Mean restarts (magenta, left axis) and mean $O(1)$ incremental $2$-cycle descent loops (blue dashed, right axis) required by the Re-Anchored Hierarchical Multi-Cycle Settler to reach $\mathcal  {H}_{\mathrm  {line}}= 0$ with $100.0\%$ success across orders $n=3\dots  8$ (\Cref  {tab:multi_order_settler}). Topological frustration peaks at $n=5$ ($8.03$ restarts, $466.6$ descents) and drops at $n=6,7,8$ ($4.58$ restarts at $n=7$, $5.00$ at $n=8$). \textbf  {(b)} Quadratic expansion of the magic nullspace dimension $\dim \ker (\setbox \z@ \hbox {\mathsurround \z@ $\textstyle L$}\mathaccent "0365{L}_n) = n^2-2n-1$ (green bars, \Cref  {thm:spectral_rationalization}) versus linear growth of the constraint rank $(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle L$}\mathaccent "0365{L}_n)=2n$ (blue bars) and mean synthesis runtime per square (orange curve, right axis, reaching $\mathcal  {H}_{\mathrm  {line}}=0$ in $479.8\text  { ms}$ at $n=8$, $64! \approx 1.27\times 10^{89}$ states).}}{16}{figure.95}\protected@file@percent }
\newlabel{fig:dimensional_relief}{{7}{16}{\textbf {Multi-order $100\%$ ground-state synthesis ($n=3\dots 8$) and the Dimensional Relief Phenomenon.} \textbf {(a)} Mean restarts (magenta, left axis) and mean $O(1)$ incremental $2$-cycle descent loops (blue dashed, right axis) required by the Re-Anchored Hierarchical Multi-Cycle Settler to reach $\Hline = 0$ with $100.0\%$ success across orders $n=3\dots 8$ (\Cref {tab:multi_order_settler}). Topological frustration peaks at $n=5$ ($8.03$ restarts, $466.6$ descents) and drops at $n=6,7,8$ ($4.58$ restarts at $n=7$, $5.00$ at $n=8$). \textbf {(b)} Quadratic expansion of the magic nullspace dimension $\dim \ker (\Ltilde _n) = n^2-2n-1$ (green bars, \Cref {thm:spectral_rationalization}) versus linear growth of the constraint rank $\rank (\Ltilde _n)=2n$ (blue bars) and mean synthesis runtime per square (orange curve, right axis, reaching $\Hline =0$ in $479.8\text { ms}$ at $n=8$, $64! \approx 1.27\times 10^{89}$ states)}{figure.95}{}}
