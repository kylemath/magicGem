\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Multi-order synthesis benchmark of Multi-Exchange Iterated Local Search (ME-ILS) across orders $n = 3, 4, 5, 6, 7, 8, 9, 10$ ($900$ total trials).} We report the nullspace-to-constraint ratio $\eta _{\mathrm  {MC}}(n) = (n^2-2n-1)/(2n)$, the diagonal-free $(2,2)$ subspace fraction $f_{\mathrm  {null}}(n) = 1 - 2/(n-1)^2$, and the per-step $2$-exchange neighborhood $\binom  {n^2}{2}$, certified by \texttt  {verify\_paper\_d.py}. For baseline comparisons, the $5{,}000$-sample empirical mean $\langle \mathcal  {H}_{\mathrm  {line}}\rangle _{\mathrm  {rand}} = 31{,}080$ at $n=6$ matches the exact asymptotic expectation $2\|\mathbf  {z}\|^2 = 31{,}104$ within $0.077\%$.}}{20}{table.72}\protected@file@percent }
\newlabel{tab:multi_order_settler}{{8}{20}{\textbf {Multi-order synthesis benchmark of Multi-Exchange Iterated Local Search (ME-ILS) across orders $n = 3, 4, 5, 6, 7, 8, 9, 10$ ($900$ total trials).} We report the nullspace-to-constraint ratio $\eta _{\mathrm {MC}}(n) = (n^2-2n-1)/(2n)$, the diagonal-free $(2,2)$ subspace fraction $f_{\mathrm {null}}(n) = 1 - 2/(n-1)^2$, and the per-step $2$-exchange neighborhood $\binom {n^2}{2}$, certified by \texttt {verify\_paper\_d.py}. For baseline comparisons, the $5{,}000$-sample empirical mean $\langle \mathcal {H}_{\mathrm {line}}\rangle _{\mathrm {rand}} = 31{,}080$ at $n=6$ matches the exact asymptotic expectation $2\|\mathbf {z}\|^2 = 31{,}104$ within $0.077\%$}{table.72}{}}
\newlabel{eq:null_plaquette_fraction}{{23}{20}{Why \texorpdfstring {$5\times 5$}{5x5} Requires More Restarts Than \texorpdfstring {$10\times 10$}{10x10}: Nullspace Dimensional Relief}{equation.74}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Multi-order certified ground-state synthesis ($n=3\dots  10$) and nullspace dimensional relief.} \textbf  {(a)} Mean basin-hopping restarts (magenta, left axis) and mean $O(1)$ incremental $2$-cycle descent loops (navy dashed, right axis) required by ME-ILS to achieve $100.0\%$ ground-state convergence ($\mathcal  {H}_{\mathrm  {line}}= 0$) across $900$ total trials in $n=3\dots  10$ (\Cref  {tab:multi_order_settler}). Combinatorial frustration peaks at $n=5$ (Maxwell--Calladine ratio $\eta _{\mathrm  {MC}} = 1.40$, requiring $8.03$ mean restarts and $466.6$ descents, shaded pink) and declines monotonically across the shaded Nullspace Relief zone $n=6\dots  10$, falling to $7.28$ ($n=6$), $4.02$ ($n=7$), $4.32$ ($n=8$), $4.06$ ($n=9$), and $3.34$ restarts ($258.5$ descents) at $n=10$. \textbf  {(b)} Quadratic expansion of the magic nullspace $\dim \ker (\setbox \z@ \hbox {\mathsurround \z@ $\textstyle L$}\mathaccent "0365{L}_n) = n^2 - 2n - 1$ ($2, 7, 14, 23, 34, 47, 62, 79$, green bars) versus linear growth of constraint rank $\operatorname  {rank}(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle L$}\mathaccent "0365{L}_n) = 2n$ ($6\dots  20$, blue bars) and mean synthesis runtime per square (orange curve, right axis: $0.1~\text  {ms}$ at $n=3$ to $1{,}001.6~\text  {ms}$ at $n=10$). The diagonal-free $(2,2)$ subspace fraction $f_{\mathrm  {null}}(n) = 1 - 2/(n-1)^2$ climbs from $50.0\%$ ($n=3$) and $87.5\%$ ($n=5$) to $97.5\%$ ($n=10$), rendering almost all line-preserving plaquette kicks unconstrained by diagonal penalties and explaining the dramatic decline in search restarts.}}{21}{figure.76}\protected@file@percent }
\newlabel{fig:dimensional_relief}{{7}{21}{\textbf {Multi-order certified ground-state synthesis ($n=3\dots 10$) and nullspace dimensional relief.} \textbf {(a)} Mean basin-hopping restarts (magenta, left axis) and mean $O(1)$ incremental $2$-cycle descent loops (navy dashed, right axis) required by ME-ILS to achieve $100.0\%$ ground-state convergence ($\Hline = 0$) across $900$ total trials in $n=3\dots 10$ (\Cref {tab:multi_order_settler}). Combinatorial frustration peaks at $n=5$ (Maxwell--Calladine ratio $\eta _{\mathrm {MC}} = 1.40$, requiring $8.03$ mean restarts and $466.6$ descents, shaded pink) and declines monotonically across the shaded Nullspace Relief zone $n=6\dots 10$, falling to $7.28$ ($n=6$), $4.02$ ($n=7$), $4.32$ ($n=8$), $4.06$ ($n=9$), and $3.34$ restarts ($258.5$ descents) at $n=10$. \textbf {(b)} Quadratic expansion of the magic nullspace $\dim \ker (\Ltilde _n) = n^2 - 2n - 1$ ($2, 7, 14, 23, 34, 47, 62, 79$, green bars) versus linear growth of constraint rank $\operatorname {rank}(\Ltilde _n) = 2n$ ($6\dots 20$, blue bars) and mean synthesis runtime per square (orange curve, right axis: $0.1~\text {ms}$ at $n=3$ to $1{,}001.6~\text {ms}$ at $n=10$). The diagonal-free $(2,2)$ subspace fraction $f_{\mathrm {null}}(n) = 1 - 2/(n-1)^2$ climbs from $50.0\%$ ($n=3$) and $87.5\%$ ($n=5$) to $97.5\%$ ($n=10$), rendering almost all line-preserving plaquette kicks unconstrained by diagonal penalties and explaining the dramatic decline in search restarts}{figure.76}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Scaling to $n = 50$ and $n = 100$: The Nullspace-Relief Plateau, Bilinear Plaquette Acceleration, and Head-to-Head Solver Competition}{21}{section.77}\protected@file@percent }
\newlabel{sec:large_scale}{{6}{21}{Scaling to \texorpdfstring {$n = 50$}{n = 50} and \texorpdfstring {$n = 100$}{n = 100}: The Nullspace-Relief Plateau, Bilinear Plaquette Acceleration, and Head-to-Head Solver Competition}{section.77}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}The Complete Order-by-Order Scaling Census from $n = 3$ to $n = 50$}{21}{subsection.78}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Complete order-by-order scaling census across all $48$ consecutive orders from $n=3$ to $n=50$ and algebraic $O(n^3)$ acceleration up to $n=100$.} \textbf  {(a)} Per-order mean restarts (light magenta circles, left axis) and $5$-order moving average (dark magenta curve) required by ME-ILS to reach $\mathcal  {H}_{\mathrm  {line}}= 0$ with $100.0\%$ success across all $48$ consecutive orders from $n=3$ to $n=50$, overlaid with mean $2$-exchange descent steps executed per restart $d_{\mathrm  {run}}(n) = \text  {descents}/(\text  {restarts}+1)$ (navy dashed curve, right axis). Following the $n=5$ frustration peak ($8.03$ restarts), basin-hopping restarts stabilize across the $n=6\dots  50$ Nullspace Relief Plateau at a median of $4.32$ restarts ($\text  {IQR} = 2.67\text  {--}8.67$, mean $6.15 \pm 4.49$, geometric basin success probability $p_{\mathrm  {basin}} \approx 14.0\%$), while per-restart descent steps grow strictly linearly as $d_{\mathrm  {run}}(n) = 3.52\,n + 20.86$ ($r = 0.9934, p = 6.39\times 10^{-45}$). \textbf  {(b)} Log--log wall-clock synthesis time across $n=10\dots  100$, contrasting Baseline All-Pairs ME-ILS ($n=10\dots  50$, orange circles, scaling empirically as $O(n^{5.92})$, $r = 0.9571$) against Bilinear-Identity + Active-Set ME-ILS ($n=10\dots  100$, green diamonds for total time and navy squares for per-restart time, scaling as $O(n^{2.93})$, $r = 0.9924, p = 1.08\times 10^{-6}$). Bilinear plaquette acceleration prunes redundant pair evaluations with zero mathematical approximation, accelerating synthesis by $35.0\times $ at $n=48$ ($8.02~\text  {s}$ vs $280.95~\text  {s}$) and solving $n=100$ ($10{,}000$ cells, state space $10{,}000! \approx 2.85\times 10^{35{,}659}$) in a mean of $147.70~\text  {s}$ (minimum $34.06~\text  {s}$) versus an extrapolated $7{,}420~\text  {s}$ ($2.1~\text  {hours}$) for the baseline.}}{22}{figure.80}\protected@file@percent }
\newlabel{fig:scan_3_to_50}{{8}{22}{\textbf {Complete order-by-order scaling census across all $48$ consecutive orders from $n=3$ to $n=50$ and algebraic $O(n^3)$ acceleration up to $n=100$.} \textbf {(a)} Per-order mean restarts (light magenta circles, left axis) and $5$-order moving average (dark magenta curve) required by ME-ILS to reach $\Hline = 0$ with $100.0\%$ success across all $48$ consecutive orders from $n=3$ to $n=50$, overlaid with mean $2$-exchange descent steps executed per restart $d_{\mathrm {run}}(n) = \text {descents}/(\text {restarts}+1)$ (navy dashed curve, right axis). Following the $n=5$ frustration peak ($8.03$ restarts), basin-hopping restarts stabilize across the $n=6\dots 50$ Nullspace Relief Plateau at a median of $4.32$ restarts ($\text {IQR} = 2.67\text {--}8.67$, mean $6.15 \pm 4.49$, geometric basin success probability $p_{\mathrm {basin}} \approx 14.0\%$), while per-restart descent steps grow strictly linearly as $d_{\mathrm {run}}(n) = 3.52\,n + 20.86$ ($r = 0.9934, p = 6.39\times 10^{-45}$). \textbf {(b)} Log--log wall-clock synthesis time across $n=10\dots 100$, contrasting Baseline All-Pairs ME-ILS ($n=10\dots 50$, orange circles, scaling empirically as $O(n^{5.92})$, $r = 0.9571$) against Bilinear-Identity + Active-Set ME-ILS ($n=10\dots 100$, green diamonds for total time and navy squares for per-restart time, scaling as $O(n^{2.93})$, $r = 0.9924, p = 1.08\times 10^{-6}$). Bilinear plaquette acceleration prunes redundant pair evaluations with zero mathematical approximation, accelerating synthesis by $35.0\times $ at $n=48$ ($8.02~\text {s}$ vs $280.95~\text {s}$) and solving $n=100$ ($10{,}000$ cells, state space $10{,}000! \approx 2.85\times 10^{35{,}659}$) in a mean of $147.70~\text {s}$ (minimum $34.06~\text {s}$) versus an extrapolated $7{,}420~\text {s}$ ($2.1~\text {hours}$) for the baseline}{figure.80}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {Representative milestone orders from the complete $n=3\dots  50$ order-by-order scaling census of Baseline All-Pairs ME-ILS alongside $n=100$ under Bilinear-Identity + Active-Set ME-ILS.} Across all $48$ consecutive orders $n=3\dots  50$ and at $n=100$, ME-ILS achieves $100.0\%$ ground-state convergence ($\mathcal  {H}_{\mathrm  {line}}=0$), certified in \texttt  {results\_paper\_d.json}.}}{22}{table.82}\protected@file@percent }
