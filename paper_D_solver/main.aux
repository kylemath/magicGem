\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Continuous 2D Bubble Trinity relaxation dynamics, border-parking failure mechanism, and $6$-tier operator ablation.} \textbf  {(a)} Kernel-induced line energy $\mathcal  {H}_{\mathrm  {ind}}(t)$ across $250$ continuous integration steps ($\Delta t = 0.025$) for the four interactive presets of \Cref  {tab:bubble_regimes}. While continuous energy in Preset~IV (\emph  {Centrifugal Balance}) drops by $37.5\%$ (from $1{,}681.89$ to $1{,}050.55$) across the shaded \emph  {Amplitude-Averaging Gap}, discrete Hungarian bipartite projection remains frozen at $\mathcal  {H}_{\mathrm  {line}}= 2{,}336$ ($0\%$ convergence) and greedy nearest-cell projection reaches at best $\min \mathcal  {H}_{\mathrm  {line}}= 1{,}480$ ($0\%$). \textbf  {(b)} Spatial $2\mathrm  {D}$ bubble trajectories and terminal coordinates in Preset~IV ($k_w=1.8, k_f=2.2, k_c=0.5, k_s=0.85, T=0.4$), demonstrating the border-parking phenomenon: bubbles carrying positive ($+Z$, red) and negative ($-Z$, blue) centered height deviations settle along cell boundaries, blending their continuous Gaussian weights toward zero without traversing discrete permutation saddles. \textbf  {(c)} Controlled $6$-tier operator ablation across $n=4$ ($200$ trials) and $n=5$ ($100$ trials) (\Cref  {tab:physical_analogs_ablation}). Single-element baselines fail or degrade rapidly at higher orders (Tier~$0$ continuous drift $0.0\% / 0.0\%$; Tier~$1$ pure $2$-cycle quench $20.0\% / 1.0\%$; Tier~$2$ $(2+3)$-cycle simulated annealing $32.5\% / 0.0\%$). Incorporating line-preserving $(2,2)$ plaquette moves (Tier~$3$, $29.0\% / 1.0\%$), candidate-list swaps (Tier~$4$, $42.5\% / 2.0\%$), and funnel leash tethering (Tier~$5$, $58.0\% / 6.0\%$) progressively unlocks frustrated basins, while Multi-Exchange Iterated Local Search (ME-ILS, Tier~$6$) achieves $100.0\% / 100.0\%$ certified ground-state synthesis within $80$ restarts.}}{18}{figure.65}\protected@file@percent }
\newlabel{fig:bubble_trinity}{{6}{18}{\textbf {Continuous 2D Bubble Trinity relaxation dynamics, border-parking failure mechanism, and $6$-tier operator ablation.} \textbf {(a)} Kernel-induced line energy $\Hind (t)$ across $250$ continuous integration steps ($\Delta t = 0.025$) for the four interactive presets of \Cref {tab:bubble_regimes}. While continuous energy in Preset~IV (\emph {Centrifugal Balance}) drops by $37.5\%$ (from $1{,}681.89$ to $1{,}050.55$) across the shaded \emph {Amplitude-Averaging Gap}, discrete Hungarian bipartite projection remains frozen at $\Hline = 2{,}336$ ($0\%$ convergence) and greedy nearest-cell projection reaches at best $\min \Hline = 1{,}480$ ($0\%$). \textbf {(b)} Spatial $2\mathrm {D}$ bubble trajectories and terminal coordinates in Preset~IV ($k_w=1.8, k_f=2.2, k_c=0.5, k_s=0.85, T=0.4$), demonstrating the border-parking phenomenon: bubbles carrying positive ($+Z$, red) and negative ($-Z$, blue) centered height deviations settle along cell boundaries, blending their continuous Gaussian weights toward zero without traversing discrete permutation saddles. \textbf {(c)} Controlled $6$-tier operator ablation across $n=4$ ($200$ trials) and $n=5$ ($100$ trials) (\Cref {tab:physical_analogs_ablation}). Single-element baselines fail or degrade rapidly at higher orders (Tier~$0$ continuous drift $0.0\% / 0.0\%$; Tier~$1$ pure $2$-cycle quench $20.0\% / 1.0\%$; Tier~$2$ $(2+3)$-cycle simulated annealing $32.5\% / 0.0\%$). Incorporating line-preserving $(2,2)$ plaquette moves (Tier~$3$, $29.0\% / 1.0\%$), candidate-list swaps (Tier~$4$, $42.5\% / 2.0\%$), and funnel leash tethering (Tier~$5$, $58.0\% / 6.0\%$) progressively unlocks frustrated basins, while Multi-Exchange Iterated Local Search (ME-ILS, Tier~$6$) achieves $100.0\% / 100.0\%$ certified ground-state synthesis within $80$ restarts}{figure.65}{}}
