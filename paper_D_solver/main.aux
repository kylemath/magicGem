\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Head-to-head empirical solver competition at orders $n = 46$ ($2{,}116$ cells), $n = 48$ ($2{,}304$ cells), and $n = 100$ ($10{,}000$ cells) across identical uniform random starting permutations.} \textbf  {(a)} Mean wall-clock time to certified ground state ($\mathcal  {H}_{\mathrm  {line}}=0$, log scale; individual seed times plotted as dark green dots for Bilinear ME-ILS). Bilinear + Active-Set ME-ILS achieves $100.0\%$ convergence across all seeds, accelerating synthesis by $34.7\times $ at $n=46$ ($11.12~\text  {s}$ vs $386.13~\text  {s}$), $35.0\times $ at $n=48$ ($8.02~\text  {s}$ vs $280.95~\text  {s}$), and $50.2\times $ at $n=100$ ($147.70~\text  {s}$ mean, $34.06~\text  {s}$ minimum vs an estimated $7{,}420~\text  {s}$). Simulated Annealing fails across all orders ($0/9$ solved, trapped at $\sim 3~\text  {s}$), while Defective-Line CBLS maxes out its $80$-restart budget on $n=46$ ($168.06~\text  {s}$, $0/3$) and $n=100$ ($3{,}582.92~\text  {s}$, $0/3$), succeeding partially only on $n=48$ ($152.89~\text  {s}$, $2/3$). \textbf  {(b)} Total operator evaluations (compute budget, log scale), demonstrating an $18.1\times \text  {--}19.2\times $ reduction in evaluated candidates by Bilinear ME-ILS ($1.02\times 10^9$ at $n=46$, $7.33\times 10^8$ at $n=48$, and $1.88\times 10^{10}$ at $n=100$). \textbf  {(c)} Mean final residual energy $\mathcal  {H}_{\mathrm  {line}}(S_\infty )$ on log scale (exact ground states plotted at baseline $0.5$). Simulated Annealing stalls far above the ground state ($\mathcal  {H}_{\mathrm  {line}}= 124.0$ at $n=46,48$ and $3{,}148.0$ at $n=100$), and Defective-Line CBLS stalls at $\mathcal  {H}_{\mathrm  {line}}= 30.7$ ($n=46$) and $50.7$ ($n=100$), trapped above the fundamental endgame barrier $\mathcal  {H}_{\mathrm  {line}}\ge 8$ (red dotted line). ME-ILS circumvents this barrier via rank-$(n+2)$ bilinear plaquette moves to reach exact ground state $\mathcal  {H}_{\mathrm  {line}}=0$ with $100.0\%$ reliability.}}{25}{figure.94}\protected@file@percent }
\newlabel{fig:competition_100}{{9}{25}{\textbf {Head-to-head empirical solver competition at orders $n = 46$ ($2{,}116$ cells), $n = 48$ ($2{,}304$ cells), and $n = 100$ ($10{,}000$ cells) across identical uniform random starting permutations.} \textbf {(a)} Mean wall-clock time to certified ground state ($\Hline =0$, log scale; individual seed times plotted as dark green dots for Bilinear ME-ILS). Bilinear + Active-Set ME-ILS achieves $100.0\%$ convergence across all seeds, accelerating synthesis by $34.7\times $ at $n=46$ ($11.12~\text {s}$ vs $386.13~\text {s}$), $35.0\times $ at $n=48$ ($8.02~\text {s}$ vs $280.95~\text {s}$), and $50.2\times $ at $n=100$ ($147.70~\text {s}$ mean, $34.06~\text {s}$ minimum vs an estimated $7{,}420~\text {s}$). Simulated Annealing fails across all orders ($0/9$ solved, trapped at $\sim 3~\text {s}$), while Defective-Line CBLS maxes out its $80$-restart budget on $n=46$ ($168.06~\text {s}$, $0/3$) and $n=100$ ($3{,}582.92~\text {s}$, $0/3$), succeeding partially only on $n=48$ ($152.89~\text {s}$, $2/3$). \textbf {(b)} Total operator evaluations (compute budget, log scale), demonstrating an $18.1\times \text {--}19.2\times $ reduction in evaluated candidates by Bilinear ME-ILS ($1.02\times 10^9$ at $n=46$, $7.33\times 10^8$ at $n=48$, and $1.88\times 10^{10}$ at $n=100$). \textbf {(c)} Mean final residual energy $\Hline (S_\infty )$ on log scale (exact ground states plotted at baseline $0.5$). Simulated Annealing stalls far above the ground state ($\Hline = 124.0$ at $n=46,48$ and $3{,}148.0$ at $n=100$), and Defective-Line CBLS stalls at $\Hline = 30.7$ ($n=46$) and $50.7$ ($n=100$), trapped above the fundamental endgame barrier $\Hline \ge 8$ (red dotted line). ME-ILS circumvents this barrier via rank-$(n+2)$ bilinear plaquette moves to reach exact ground state $\Hline =0$ with $100.0\%$ reliability}{figure.94}{}}
