\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Group-resolved $2\times 2$ quartet energies, mixed octupole census, and concentric shell resonance across Dudeney Groups~I--XII.} \textbf  {(a)} Group-mean interior $W_{2\times 2}^{\mathrm  {int}}$ ($9$ windows, navy bars) and toroidal $W_{2\times 2}^{\mathrm  {tor}}$ ($16$ windows, olive bars) across the $12$ Dudeney groups. Reference lines indicate the universal group-mean invariants $\|\mathbf  {z}\|^2 = 1{,}360$ (interior) and $2\|\mathbf  {z}\|^2 = 2{,}720$ (toroidal) shared by Groups~II, III, and~V, while Group~I vanishes identically ($W_{2\times 2} = 0$). \textbf  {(b)} Magnitude of the mixed octupole moment $|M_{xyz}(S)| = |\DOTSB \sum@ \slimits@ X_j Y_i Z_{ij}|$ across all $880$ squares (\Cref  {prop:octupole_census}). Exactly $56$ squares achieve $M_{xyz}=0$: the $48$ associative squares of Group~III ($B_{\mathrm  {comp}}=0$, green circles at $y=0$), where antipodal centrosymmetry enforces $Q_{\mathrm  {corner}} = Q_{\mathrm  {edge}} = 0$, and $8$ anomalous non-associative squares in Groups~IX and~X ($B_{\mathrm  {comp}}=8$, magenta stars at $y=0$), where coprime shell resonance satisfies $8\,Q_{\mathrm  {corner}} = -3\,Q_{\mathrm  {edge}}$. \textbf  {(c)} Concentric shell quadrupole decomposition of anomalous Square~\texttt  {\#208} (Group~IX, $B_{\mathrm  {comp}}=8$). Main-diagonal balance forces $Q_{\mathrm  {inner}} = -Q_{\mathrm  {corner}} = +12$, while outer corners ($|XY|=9$) yield $Q_{\mathrm  {corner}} = -12$ and boundary edges ($|XY|=3$) yield $Q_{\mathrm  {edge}} = +32$, canceling exactly via Diophantine balance $M_{xyz} = -8(-12) - 3(32) = 96 - 96 = 0$.}}{11}{figure.39}\protected@file@percent }
\newlabel{fig:octupole}{{3}{11}{\textbf {Group-resolved $2\times 2$ quartet energies, mixed octupole census, and concentric shell resonance across Dudeney Groups~I--XII.} \textbf {(a)} Group-mean interior $W_{2\times 2}^{\mathrm {int}}$ ($9$ windows, navy bars) and toroidal $W_{2\times 2}^{\mathrm {tor}}$ ($16$ windows, olive bars) across the $12$ Dudeney groups. Reference lines indicate the universal group-mean invariants $\|\mathbf {z}\|^2 = 1{,}360$ (interior) and $2\|\mathbf {z}\|^2 = 2{,}720$ (toroidal) shared by Groups~II, III, and~V, while Group~I vanishes identically ($W_{2\times 2} = 0$). \textbf {(b)} Magnitude of the mixed octupole moment $|M_{xyz}(S)| = |\sum X_j Y_i Z_{ij}|$ across all $880$ squares (\Cref {prop:octupole_census}). Exactly $56$ squares achieve $M_{xyz}=0$: the $48$ associative squares of Group~III ($B_{\mathrm {comp}}=0$, green circles at $y=0$), where antipodal centrosymmetry enforces $Q_{\mathrm {corner}} = Q_{\mathrm {edge}} = 0$, and $8$ anomalous non-associative squares in Groups~IX and~X ($B_{\mathrm {comp}}=8$, magenta stars at $y=0$), where coprime shell resonance satisfies $8\,Q_{\mathrm {corner}} = -3\,Q_{\mathrm {edge}}$. \textbf {(c)} Concentric shell quadrupole decomposition of anomalous Square~\texttt {\#208} (Group~IX, $B_{\mathrm {comp}}=8$). Main-diagonal balance forces $Q_{\mathrm {inner}} = -Q_{\mathrm {corner}} = +12$, while outer corners ($|XY|=9$) yield $Q_{\mathrm {corner}} = -12$ and boundary edges ($|XY|=3$) yield $Q_{\mathrm {edge}} = +32$, canceling exactly via Diophantine balance $M_{xyz} = -8(-12) - 3(32) = 96 - 96 = 0$}{figure.39}{}}
