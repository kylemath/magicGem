\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Exhaustive $S_9$ permutation landscape ($362{,}880$ states) and the $8$ antipodal traps at order $n=3$.} \textbf  {(a)} Exact histogram of the centred line Hamiltonian $\mathcal  {H}_{\mathrm  {line}}(S)$ across all $9! = 362{,}880$ states of $S_9$, showing the ensemble mean $\mathbb  {E}[\mathcal  {H}_{\mathrm  {line}}]=480$ (\Cref  {thm:ensemble_mean}), the $8$ Lo Shu ground states at $\mathcal  {H}_{\mathrm  {line}}=0$, and the $8$ strict local-minimum traps $S_{\mathrm  {trap}}^{(3)}$ at $\mathcal  {H}_{\mathrm  {line}}=8$. \textbf  {(b)} Structure of the canonical trap $S_{\mathrm  {trap}}^{(3)}$ (\Cref  {thm:s9_traps}): all $3$ rows, the middle column, and both main diagonals sum to $15$ ($R=0$), while the outer columns sum to $14$ ($R=-2$) and $16$ ($R=+2$). Every $2$-cycle ($\min \Delta \mathcal  {H}_{\mathrm  {line}}= +4$) and every $3$-cycle ($\min \Delta \mathcal  {H}_{\mathrm  {line}}= +8$) strictly increases energy; out of all $378$ disjoint $(2,2)$ double swaps, the \emph  {unique} escaping move is the row-preserving double swap $(6\leftrightarrow 7)(3\leftrightarrow 4)$, which transitions directly to the Lo Shu ground state $\mathcal  {H}_{\mathrm  {line}}=0$ and restores the deterministic basin of $S_9$ to $100\%$.}}{11}{figure.61}\protected@file@percent }
\newlabel{fig:s9_landscape}{{4}{11}{\textbf {Exhaustive $S_9$ permutation landscape ($362{,}880$ states) and the $8$ antipodal traps at order $n=3$.} \textbf {(a)} Exact histogram of the centred line Hamiltonian $\Hline (S)$ across all $9! = 362{,}880$ states of $S_9$, showing the ensemble mean $\mathbb {E}[\Hline ]=480$ (\Cref {thm:ensemble_mean}), the $8$ Lo Shu ground states at $\Hline =0$, and the $8$ strict local-minimum traps $S_{\mathrm {trap}}^{(3)}$ at $\Hline =8$. \textbf {(b)} Structure of the canonical trap $S_{\mathrm {trap}}^{(3)}$ (\Cref {thm:s9_traps}): all $3$ rows, the middle column, and both main diagonals sum to $15$ ($R=0$), while the outer columns sum to $14$ ($R=-2$) and $16$ ($R=+2$). Every $2$-cycle ($\min \Delta \Hline = +4$) and every $3$-cycle ($\min \Delta \Hline = +8$) strictly increases energy; out of all $378$ disjoint $(2,2)$ double swaps, the \emph {unique} escaping move is the row-preserving double swap $(6\leftrightarrow 7)(3\leftrightarrow 4)$, which transitions directly to the Lo Shu ground state $\Hline =0$ and restores the deterministic basin of $S_9$ to $100\%$}{figure.61}{}}
